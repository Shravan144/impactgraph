# FalkorDB Database Configuration
# Option 1: Local Docker (default)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=ImpactGraph

# Option 2: FalkorDB Cloud / Custom Connection URL (Optional)
# FALKORDB_URL=falkor://username:password@cloud-instance.falkordb.cloud:12345
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your_password
# FALKORDB_SSL=true

# GitHub API Token (Optional, increases rate limit from 60 to 5,000 requests/hour)
# GITHUB_TOKEN=github_pat_...

# Google Gemini Configuration (Primary LLM)
# Get a free key from https://aistudio.google.com/
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-3.8-flash

# OpenRouter Configuration (Secondary / Alternative LLM)
# Get a key from https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# OpenAI Configuration (Alternative if not using OpenRouter)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Safe Ingestion Limits
MAX_FILES_TO_SELECT=30
MAX_FILES_TO_FETCH=12
MAX_FILE_SIZE=200000
